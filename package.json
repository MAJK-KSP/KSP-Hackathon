    "leaflet": "^1.9.4",
    "otplib": "^12.0.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
